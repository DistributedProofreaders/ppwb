# https://phpstan.org/config-reference

includes:
    - vendor/phpstan/phpstan/conf/bleedingEdge.neon

parameters:
    fileExtensions:
        - php
        - inc
    paths:
        - .
    excludePaths:
        - vendor
    tmpDir: .phpstan.cache

    # https://phpstan.org/user-guide/rule-levels
    level: 5

    ignoreErrors:
        - message: '#Variable .* might not be defined#'
